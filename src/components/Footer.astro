---
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="container mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-6 py-8 text-sm text-slate-600 lg:flex-row">
    <p class="text-center lg:text-left">
      &copy; {year} Pilkington Enterprises. All rights reserved.
    </p>
    <a
      href="https://github.com/Pickle58"
      class="flex items-center gap-2 rounded-full border border-slate-200 px-4 py-2 text-slate-700 transition hover:border-slate-300 hover:text-slate-900"
      rel="noreferrer"
      target="_blank"
      aria-label="Pilkington Enterprises on GitHub"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        role="img"
        aria-hidden="true"
        class="h-5 w-5"
        fill="currentColor"
      >
        <path
          fill-rule="evenodd"
