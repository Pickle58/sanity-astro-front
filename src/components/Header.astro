---
const links = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Blog", href: "/posts" },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="container mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="text-xl font-semibold tracking-tight text-slate-900">
      Pilkington
    </a>
    <nav>
      <ul class="flex items-center gap-6 text-sm font-medium text-slate-600">
        {links.map((link) => (
          <li>
            <a href={link.href} class="transition hover:text-slate-900">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
